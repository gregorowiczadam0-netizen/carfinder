{
  "name": "carfinder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx scripts/setup-db.ts && tsx scripts/seed.ts && tsx scripts/import-json.ts datasets/carfinder-rynek-pl.json",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "db:import:json": "tsx scripts/import-json.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
